# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Spotify (now-playing widget) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
SPOTIFY_REFRESH_TOKEN=

# --- Contact form ---
# Without these the form still works: messages are appended to data/messages.jsonl
# but no notification email is sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=pearson@pinsong.me
# Must be on a domain verified in Resend, or sends are rejected.
CONTACT_FROM_EMAIL=contact@wu.me
